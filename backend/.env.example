DATABASE_URL=postgresql+psycopg://ondc:replace-with-a-random-local-password@127.0.0.1:5432/ondc_fashion
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
APP_NAME=SR Fashions

# ONDC discovery: backend only. External network calls are disabled by default.
ONDC_ENVIRONMENT=local
ONDC_DOMAIN=ONDC:RET12
ONDC_NETWORK_ROLE=Seller
ONDC_NODE_TYPE=ISN
ONDC_SUBSCRIBER_ID=seller.example.com
ONDC_SUBSCRIBER_URL=https://seller.example.com
ONDC_CALLBACK_URL=https://seller.example.com
ONDC_UNIQUE_KEY_ID=replace-with-your-key-id
ONDC_COUNTRY=IND
ONDC_CITY=std:080
ONDC_PROTOCOL_VERSION=1.2.5
# Required to accept discovery. Supply via a protected environment/secret manager.
# ONDC_SIGNING_PRIVATE_KEY=replace-with-private-key-never-commit

# Empty prefix exposes POST /search. If set to /ondc, subscriber URL must end with /ondc.
ONDC_ROUTE_PREFIX=
# Supply your local mock URL. No real Registry URL or credentials are configured.
ONDC_REGISTRY_URL=http://127.0.0.1:9001/v2.0/lookup
ONDC_HTTP_TIMEOUT=5
ONDC_REGISTRY_CACHE_SECONDS=60
ONDC_REPLAY_RETENTION_SECONDS=86400
ONDC_EXTERNAL_NETWORK_ENABLED=false
# Development exceptions are allowed only when ONDC_ENVIRONMENT=local.
ONDC_ALLOW_LOCAL_PEER_SEARCH=false
ONDC_ALLOW_LOCAL_CALLBACKS=false
